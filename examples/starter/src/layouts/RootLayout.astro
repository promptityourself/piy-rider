---
import type { CollectionEntry } from 'astro:content';
import Icon from '../components/Icon.astro';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/SEO.astro';
import SiteHeader from '../components/SiteHeader.astro';
import Sources from '../components/Sources.astro';
import { config as ogConfig } from '../../scripts/og.config.mjs';
import '../styles/global.css';

interface Props {
  entry?: CollectionEntry<'blog'>;
  title?: string;
  description?: string;
}

const { entry, title, description } = Astro.props;
const { brand } = ogConfig;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <SEO entry={entry} title={title} description={description} />

    <!-- Cloudflare Web Analytics: free, cookieless, no consent banner needed.
         Renders only once a token is set — see scripts/og.config.mjs. This is
         the MANUAL install. Cloudflare's automatic setup injects the same beacon
         at the edge, Worker-served sites included, so use one or the other:
         both loads two beacons.

         No `integrity` hash on purpose: beacon.min.js is a rolling build with no
         published digest, so pinning one would break the beacon on Cloudflare's
         next release. This is Cloudflare's own documented snippet, verbatim. -->
    {brand.cloudflareAnalyticsToken && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${brand.cloudflareAnalyticsToken}"}`}
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Google Search reads BMP, GIF, ICO, PNG, JPEG, PPM and TIFF — not SVG.
         The SVG is for browsers; this PNG is what the search result shows. -->
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${brand.siteName} — RSS`} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />

    <ClientRouter />
  </head>
  <body>
    <div class="wrap">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <!-- Renders only when src/data/sources.json names a work. It sits in the
           layout rather than on the pages that use sourced material, because
           "which pages" is exactly the judgement that ends with the credit
           missing from one of them. -->
      <Sources />
      <footer class="muted">
        <p>
          © {year} {brand.siteName} ·
          <a href="/rss.xml"><Icon name="rss" size={14} /> RSS</a> ·
          <a href="/llms.txt">llms.txt</a> ·
          <a href="/media-kit">Media kit</a> ·
          <a href="/design">Design</a>
        </p>
      </footer>
    </div>
  </body>
</html>
